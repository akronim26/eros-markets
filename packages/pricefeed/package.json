{
  "name": "@eros/pricefeed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.21.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-isolation=none --test-reporter=tap dist/test/*.test.js",
    "test:engine": "python3 scripts/test-engine.py",
    "test:lifecycle": "npm run build && node --test --test-isolation=none --test-reporter=tap dist/test/lifecycle.test.js dist/test/pipeline.test.js dist/test/service.test.js && python3 scripts/test-lifecycle.py",
    "test:recovery": "python3 scripts/test-recovery.py",
    "demo:live": "npm run build && python3 scripts/demo-live.py",
    "demo:pipeline": "npm run build && python3 scripts/demo-live.py --pipeline",
    "test:reference": "python3 reference/vectors.py --check",
    "check:wire": "node dist/scripts/check-wire.js",
    "check:scope": "python3 scripts/check-scope.py",
    "verify:all": "python3 scripts/verify.py",
    "cli": "node dist/src/cli.js"
  },
  "dependencies": { "viem": "2.57.2" },
  "devDependencies": {
    "@types/node": "24.19.1",
    "node": "24.21.0",
    "typescript": "5.9.3"
  }
}
