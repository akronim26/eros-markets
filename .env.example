# Safe configuration inventory: docs/runbooks/RISK_BOOK_ENV_AND_ADDRESSES.md
# Copy to a local .env only if none exists. Never commit credentials or wallet files.
# Blank required values intentionally fail until the operator supplies real inputs.

# Actual Solidity script input: public controller/deployer address for chain 10143.
# Must match the separately loaded encrypted wallet and the fixture's index signer.
TESTNET_DEPLOYER=

# Actual verifier default and Foundry RPC setting. May contain a private provider token.
# Python verifiers require this in the process environment, not merely in this file.
ETH_RPC_URL=

# Optional Foundry RPC alias. Leave unset normally. Clear BOTH RPC variables when
# running PrepareTestnetTrade offline; also omit RPC/fork/broadcast CLI options.
# FOUNDRY_ETH_RPC_URL=

# Local mock smoke only, chain 31337. Not a public-network controller default.
LOCAL_SMOKE_SENDER=

# Test/runner settings, not deployed economic configuration.
FOUNDRY_PROFILE=risk
FORGE_SNAPSHOT_EMIT=false
# FORGE_SNAPSHOT_CHECK=true
# MONAD_GAS_CHECK=true

# Operator-only address inventory: scripts do NOT read these names automatically.
# Pass verified values as the documented CLI arguments. Populate only after a new,
# separately authorized deployment. Historical closed-market addresses are in the doc.
RISK_BOOK_ENGINE_ADDRESS=
RISK_BOOK_COLLATERAL_ADDRESS=
RISK_BOOK_VAULT_ADDRESS=
RISK_BOOK_RESERVE_VAULT_ADDRESS=
RISK_BOOK_RESOLUTION_AUTHORITY_ADDRESS=
RISK_BOOK_SMOKE_ADDRESS=
RISK_BOOK_BUYER_ADDRESS=
RISK_BOOK_SELLER_ADDRESS=
