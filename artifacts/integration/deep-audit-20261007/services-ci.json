  "findings": [
    {
      "id": "SERVICE-01",
      "severity": "medium",
      "status": "fixed",
      "defect": "Sampler requests were acknowledged after a cadence skip even though no sample ran.",
      "fix": "Retain pending requests until a finalized sample; apply the cheap cadence gate before readiness RPCs.",
      "files": [
        "scripts/e2e/market-services.ts",
        "scripts/e2e/sampler-request-policy.mjs"
      ],
      "regression": "scripts/e2e/sampler-request-policy.test.ts"
    },
    {
      "id": "SERVICE-02",
      "severity": "low",
      "status": "fixed",
      "defect": "A reverted sample replaced the last successful sample block and delayed retries.",
      "fix": "Advance lastSampleBlock only for successful receipts.",
      "files": [
        "oracle/services/market-ops/src/operations.ts"
      ],
      "regression": "oracle/services/market-ops/test/operations.test.ts"
    },
    {
      "id": "SERVICE-03",
      "severity": "medium",
      "status": "fixed",
      "defect": "The read API rejected the default frontend port 3100 Origin.",
      "fix": "Include localhost and loopback port 3100 in default development CORS origins.",
      "files": [
        "oracle/services/local-integration/src/main.ts"
      ],
      "regression": "Configuration reviewed directly; no dedicated CORS regression was added."
    },
    {
      "id": "SERVICE-04",
      "severity": "medium",
      "status": "fixed",
      "defect": "History reads requested 250-block RPC batches despite a 100-block provider limit.",
      "fix": "Limit each RPC log request to 100 inclusive blocks while preserving the 5,000-block API page.",
      "files": [
        "oracle/services/local-integration/src/read-model.ts"
      ],
      "regression": "oracle/services/local-integration/test/read-model.test.ts"
    },
    {
      "id": "SERVICE-05",
      "severity": "medium",
      "status": "fixed",
      "defect": "Repeated or unbounded indexer pages could prevent keeper and watchdog progress indefinitely.",
      "fix": "Bound pagination, detect repeated pages, and fail without partial success or cursor advancement so RPC fallback can run.",
      "files": [
        "oracle/packages/oracle-sdk/src/indexer.ts",
        "oracle/services/watchdog/src/chain.ts"
      ],
      "regression": [
        "oracle/packages/oracle-sdk/test/indexer.test.ts",
        "oracle/services/keeper/test/sources.test.ts",
        "oracle/services/watchdog/test/intake.test.ts"
      ]
    },
    {
      "id": "SERVICE-06",
      "severity": "medium",
      "status": "fixed",
      "defect": "SDK errors could expose credential-bearing indexer URLs or provider messages in service logs.",
      "fix": "Return controlled public errors without credential-bearing upstream text.",
      "files": [
        "oracle/packages/oracle-sdk/src/indexer.ts"
      ],
      "regression": "oracle/packages/oracle-sdk/test/indexer.test.ts"
    },
    {
      "id": "CI-01",
      "severity": "medium",
      "status": "fixed-locally",
      "defect": "Clean CI did not build Timelock, which is imported only by skipped deployment scripts; fresh deployment planner tests failed with a missing artifact.",
      "fix": "Explicitly compile lib/solady/src/accounts/Timelock.sol using the integration profile before planner tests; preserve every existing gate.",
      "files": [
        ".github/workflows/oracle.yml"
      ],
      "regression": "Isolated clean source copy reproduced the original missing-artifact failure and passed the exact workspace test command after the additional build."
    }
  ],
