# Copy to .env.local. NEXT_PUBLIC_ values are shipped to the browser. See docs_frontend/frontend.md §5.1, §19.8.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Optional same-origin read proxy for a sponsored/private RPC. Keep its URL server-side.
NEXT_PUBLIC_READ_RPC_URL=/api/rpc
MONAD_RPC_URL=
# Server-only comma-separated HTTPS alternatives. Never prefix these with NEXT_PUBLIC_.
MONAD_READ_FALLBACK_URLS=
# Optional concurrency capacities: primary, then each unique fallback (default 8 each).
MONAD_READ_RPC_CAPACITIES=
# Optional separate frontend read pool; unset inherits the shared settings above.
# MONAD_FRONTEND_READ_FALLBACK_URLS=
# MONAD_FRONTEND_READ_RPC_CAPACITIES=
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadscan.com
# Privy app ID (public). Required for login and both embedded/external wallets.
# Blank keeps public market reads available with wallet actions disabled.
NEXT_PUBLIC_PRIVY_APP_ID=
# Read-only Envio GraphQL endpoint. Never put an admin secret in public variables.
NEXT_PUBLIC_INDEXER_URL=
# Bind the endpoint to the selected chain and registry: 10143:0x... (lowercase).
NEXT_PUBLIC_INDEXER_DEPLOYMENT=

# Optional delegated trading. SERVER ONLY; never prefix these with NEXT_PUBLIC_.
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_TRADE_SIGNER_ID=
PRIVY_POLICY_TRADE_ID=
# Protection uses a separate authorization key and quorum.
PRIVY_PROTECT_AUTHORIZATION_PRIVATE_KEY=
PRIVY_PROTECT_SIGNER_ID=
PRIVY_POLICY_PROTECT_ID=
AUTOMATION_DB=var/automation.sqlite
# Optional service wallet pays gas for permissionless claim delivery to the owner.
CLAIM_DELIVERY_PRIVATE_KEY=
