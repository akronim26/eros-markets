# Copy to .env.local. Only public values here (shipped to the browser). See docs_frontend/frontend.md §5.1, §19.8.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadscan.com
# Privy app ID (public). Required for login and both embedded/external wallets.
# Blank keeps public market reads available with wallet actions disabled.
NEXT_PUBLIC_PRIVY_APP_ID=
