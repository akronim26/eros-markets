{
  "source": "task O10.2; plan section 6.3 rule 3, section 7.3. Expected codes assigned by hand from the rules. specHash vectors live in spechash.json.",
  "codes": {
    "0": "ok",
    "1": "https",
    "2": "host",
    "3": "{id}",
    "4": "urlParam",
    "5": "L1 host != allowList[0]",
    "6": "path",
    "7": "finalValue",
    "8": "op/type",
    "9": "decimals",
    "10": "target",
    "11": "buffer/timeout",
    "12": "authRef"
  },
  "rules": {
    "order": "codes are checked in order 1..12; the first failure is returned",
    "https": "template starts with the exact lowercase bytes 'https://'",
    "host": "the host ends at the first '/', '?' or '#' after the scheme; it is lowercase [a-z0-9-] labels of 1-63 bytes joined by '.', at least two labels, no label starting or ending with '-'",
    "id": "'{id}' appears at most once; if present, a '/' must exist at or after the end of the host and '{id}' must come after the first such '/'",
    "urlParam": "[A-Za-z0-9._~-]{1,128}, always checked (even when the template has no '{id}')",
    "l1Host": "the host of the template with '{id}' replaced by urlParam equals allowList[0]",
    "path": "finalPath and valuePath: 1-256 bytes; segments split by '.'; each segment is [A-Za-z0-9_$-]+ followed by zero or more '[n]' with n = 0|[1-9][0-9]{0,5}",
    "finalValue": "non-empty",
    "opType": "valueType in {0 STRING,1 INT,2 DECIMAL}, op in {0 EQ,1 NEQ,2 GT,3 GTE,4 LT,5 LTE}; STRING allows EQ and NEQ only",
    "decimals": "0 unless DECIMAL; DECIMAL at most 18",
    "target": "INT -?(0|[1-9][0-9]*); DECIMAL -?(0|[1-9][0-9]*)(\\.[0-9]+)? with at most `decimals` fractional digits; STRING non-empty",
    "timing": "bufferSecs < l1TimeoutSecs; bufferSecs in [bufferMinSecs, bufferMaxSecs]; l1TimeoutSecs in [l1TimeoutMinSecs, l1TimeoutMaxSecs]",
    "authRef": "authRef == 0 or known to the registry (authRefKnown in each case)"
  },
  "bounds": {
    "bufferMinSecs": 60,
    "bufferMaxSecs": 21600,
    "l1TimeoutMinSecs": 3600,
    "l1TimeoutMaxSecs": 86400
  },
