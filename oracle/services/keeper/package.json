    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eros-oracle/oracle-sdk": "workspace:*",
    "viem": "2.57.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  }
}
