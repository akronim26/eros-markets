# Copy to oracle/services/panel-runner/.env (git-ignored); Bun loads it from this directory.
# Schema: src/main.ts. Never commit real values.
NETWORK=monad-testnet
RPC_URL=https://testnet-rpc.monad.xyz
# Panel pinned by listings/inputs/mlb-849833.json (ADJ-49); order matters.
PANEL_MODELS=groq:openai/gpt-oss-120b@2026-10-03,nvidia:moonshotai/kimi-k3@2026-10-03,aicredits:anthropic/claude-sonnet-5.5@2026-10-04
# Testnet hot keys (ADJ-38, deployments/testnet-keys.env): relayer = KEEPER_1 (panel/committee submission).
RELAYER_PRIVATE_KEY=
ATTESTOR_PRIVATE_KEY=
# Provider keys for the three panel models.
GROQ_API_KEY=
NVIDIA_API_KEY=
CREDITED_API_KEY=
# Optional
# CALIBRATION=
# SOURCES=
# SNAPSHOT_DIR=snapshots
# POLL_MS=30000
# FROM_BLOCK=
