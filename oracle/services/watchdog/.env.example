# Copy to oracle/services/watchdog/.env (git-ignored); Bun loads it from this directory.
# Schema: src/main.ts. Never commit real values.
NETWORK=monad-testnet
# Current frontend public manifest is the default; explicit overrides:
# DEPLOYMENT_MANIFEST=/absolute/path/to/public-manifest.json
# DEPLOYMENTS_FILE=/absolute/path/to/an-explicit-historical-deployment.json
# Explicit opt-in for the current testnet's 120/120/300-second assertion windows.
# Omit on production (600-second safeguard); this override refuses every chain except 10143.
WATCHDOG_TESTNET_DISPUTE_MARGIN_SECS=30
# The watchdog should use its own RPC, separate from the keeper's (plan 9.2).
RPC_URL=https://testnet-rpc.monad.xyz
# Testnet hot key (ADJ-38, deployments/testnet-keys.env WATCHDOG_PRIVATE_KEY).
WATCHDOG_PRIVATE_KEY=
# Watchdog model (ADJ-48); a different family from the panel.
WATCHDOG_MODEL=google:gemini-3.8-flash@2026-10-03
GEMINI_API_KEY=
# Optional
# FALLBACKS=
# FEED_AUTH=
# PAGER_WEBHOOK=
# INDEXER_URL=
# INDEXER_MAX_LAG_BLOCKS=300
# SNAPSHOT_DIR=snapshots
# POLL_MS=15000
# FROM_BLOCK=
