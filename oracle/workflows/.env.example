# Copy to oracle/workflows/.env (git-ignored) for `cre workflow simulate`. Never commit real values.
# The sim relayer key: `cre workflow simulate --broadcast` signs writes to the MockKeystoneForwarder with it (plan 7.5).
CRE_ETH_PRIVATE_KEY=
# RPCs per target (project.yaml).
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=
# Provider keys (secrets.yaml): one variable per secret value.
# Shared API-Sports key for the provider catalog (football, baseball, F1,
# handball, hockey, MMA, NBA, American football, rugby, volleyball).
# Sent as x-apisports-key; never expose it in frontend/public configuration.
# Configure the corresponding authRef/header in the selected workflow target.
SPORTSDATA_API_KEY_VALUE=
# Model API keys for oracle-cli ambiguity (O22.3/O22.4).
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
